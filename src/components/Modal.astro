---
import ImageComp from "./ImageComp.astro";

interface Image {
  id: number;
  imagePath: string;
  imageAlt: string;
  title: string;
}

interface Props {
  images: Image[];
}

const { images } = Astro.props;
---

<div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-4">
  <div class="modal-content bg-white rounded-lg overflow-hidden max-w-4xl w-full max-h-[90vh] relative flex flex-col">
    <div class="absolute top-3 right-3 z-10">
      <button id="closeModal" class="text-white bg-black/50 hover:bg-black p-2 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <div class="relative flex-1 min-h-0">
      <div id="modalImageContainer" class="h-full">
        {images.map((image) => (
          <div id={`modal-image-${image.id}`} class="modal-image hidden h-full">
            <div class="h-[70vh] relative">
              <ImageComp 
                imagePath={image.imagePath} 
                imageAlt={image.imageAlt} 
                styles="w-full h-full object-contain" 
              />
            </div>
            <div class="p-4">
              <h3 class="text-xl font-bold">{image.title}</h3>
              <p class="text-gray-600">{image.imageAlt}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <div class="p-4 flex justify-between">
      <button id="prevImage" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>
      <button id="nextImage" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>
  </div>
</div>